# Required for the visible form to send messages. Server-only; never prefix with NEXT_PUBLIC.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender on a domain verified in Resend; otherwise uses their test sender,
# which can only deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=
# Canonical origin without a path. On Vercel, falls back to the production domain
# when unset; elsewhere it defaults to localhost for local work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
